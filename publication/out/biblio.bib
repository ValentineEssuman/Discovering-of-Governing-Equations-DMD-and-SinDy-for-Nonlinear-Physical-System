	keywords = {Algorithm design and analysis, Complexity theory, Estimation, Kernel, Signal processing algorithms, Signal reconstruction, Support vector machines, kernel methods, machine learning, nonlinear signal reconstruction, recurrent least-squares, support vector machine, system identification},
